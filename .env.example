# ============================================================
# Deep Potential (JAX) - Environment Variables
# ============================================================
# Copy this file to .env and adjust as needed.
# These variables can also be set directly in your shell.

# --- JAX Platform ------------------------------------------------
# Force CPU backend (fast compilation, no GPU required).
# Useful for local debugging on MacBook or when GPU is unavailable.
# JAX_PLATFORM_NAME=cpu

# --- GPU Memory ---------------------------------------------------
# Disable JAX's default 90% GPU memory pre-allocation.
# Recommended on shared/busy GPUs to avoid OOM at startup.
# XLA_PYTHON_CLIENT_PREALLOCATE=false

# --- XLA Debugging ------------------------------------------------
# Show XLA compilation logs (verbose; only for deep debugging).
# XLA_FLAGS="--xla_dump_to=/tmp/xla_dump"
