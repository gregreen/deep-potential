def main():
    key = jax.random.PRNGKey(42)

    phi_params = {'n_dim': 3, 'n_hidden': 3, 'hidden_size': 128}

    # Example: Make omega and u_x trainable, but freeze r_c and all other params
    frameshift_params = {
        'omega0': 25.0,
        'omega0_trainable': True,
        'r_c0': 8.1,
        'r_c0_trainable': False,  # This will be frozen
        'u_x0': 11.0,
        'u_x0_trainable': True,
        'u_y0': 5.0,
        'u_y0_trainable': False,  # This will be frozen
        'u_z0': 7.0,
        'u_z0_trainable': False,  # This will be frozen
    }

    # The PotentialModel will now be created with these settings
    model = PotentialModel(key, "models/PotentialJAX", phi_params, frameshift_params)

    # When you call train_potential, the partition logic will automatically
    # separate the trainable and frozen parameters. The gradients will only be
    # computed for the trainable ones, and the optimizer will only update them.
    
    # ... create dummy data and call train_potential ...

if __name__ == "__main__":
    main()